{
  "name": "sprintnote",
  "version": "1.5.0",
  "versaoExibida": "1.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "teste:notas": "node --experimental-strip-types --no-warnings lib/editor/markdown-documento.teste.ts",
    "teste:kanban": "node --experimental-strip-types --no-warnings lib/kanban/recorrencia.teste.ts && node --experimental-strip-types --no-warnings lib/kanban/modelos.teste.ts && node --experimental-strip-types --no-warnings lib/kanban/fundo.teste.ts",
    "teste:quadro": "node --experimental-strip-types --no-warnings lib/quadro/modelo.teste.ts",
    "teste:sincronizacao": "node --experimental-strip-types --no-warnings lib/estado/mesclar.teste.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run teste:legados",
    "teste:legados": "npm run teste:notas && npm run teste:kanban && npm run teste:quadro && npm run teste:sincronizacao",
    "test:e2e": "playwright test"
  },
